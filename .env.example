# NODE_ENV: Runtime environment ('production' | 'development' | 'test').
# If omitted/unset, LingoPro defaults to 'production' (fail-closed).
# Unknown values cause startup validation failure.
NODE_ENV="development"

# GEMINI_API_KEY: Required in production for primary Gemini AI API calls.
# Must be configured as a server-side secret only (never prefix with VITE_).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted.
# Used for self-referential links and API endpoints.
APP_URL="MY_APP_URL"

# COMET_API_KEY: Optional server-side failover API key (CometAPI).
# Automatically engages when the primary Gemini API encounters transient rate limits or quota exhaustion.
COMET_API_KEY="MY_COMET_API_KEY"

# Distributed Rate Limiting (MANDATORY IN PRODUCTION - Upstash Redis REST API)
# Production deployments REQUIRE both UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.
# In production (or when NODE_ENV is unset), if Redis is missing or unreachable, protected API endpoints
# FAIL CLOSED (HTTP 503) and NEVER fall back to process-local in-memory rate limiting.
# Bounded local in-memory rate limiting is permitted ONLY when NODE_ENV is explicitly 'development' or 'test'.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Configurable Rate Limits (Must be finite positive integers > 0; invalid values fail startup)
RATE_LIMIT_AI_PER_MIN="25"
RATE_LIMIT_AUDIO_PER_MIN="15"
RATE_LIMIT_STANDARD_PER_MIN="60"
RATE_LIMIT_DAILY_QUOTA="500"
