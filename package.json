{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=build/server.cjs",
    "start": "node build/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "NODE_ENV=test tsx server/securityRegressionTests.ts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@upstash/redis": "^1.39.0",
    "@vitejs/plugin-react": "^5.2.0",
    "compression": "^1.8.2",
    "dotenv": "^18.0.5",
    "esbuild": "^0.28.2",
    "express": "^4.22.3",
    "lucide-react": "^1.52.0",
    "motion": "^12.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "serverless-http": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.4.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3"
  }
